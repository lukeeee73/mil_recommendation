# ──────────────────────────────────────────────────────
# 군입대 준비물 추천 서버 환경 변수
# ──────────────────────────────────────────────────────
#
# 사용 방법:
#   1. 이 파일을 복사해서 .env 라는 이름으로 저장
#      cp .env.example .env
#
#   2. 아래 값들을 실제 API 키로 채우기
#
#   3. .env 는 절대 git에 올리지 마세요! (.gitignore에 포함됨)
#

# ── 네이버 쇼핑 검색 API ───────────────────────────────
# 발급 방법:
#   1. https://developers.naver.com/apps/#/register 접속
#   2. "검색" API 선택 후 앱 등록
#   3. Client ID / Client Secret 복사
#
# 없으면?: 서버가 정적 가격 데이터(폴백)로 자동 실행됨
NAVER_CLIENT_ID=여기에_클라이언트_아이디_입력
NAVER_CLIENT_SECRET=여기에_클라이언트_시크릿_입력

# ── 쿠팡 Partners API ──────────────────────────────────
# 발급 방법:
#   1. https://partners.coupang.com 에서 가입·채널 등록 → 승인 대기
#   2. 승인 후 "개발자 센터 > API Key 관리" 에서 발급
#   3. ACCESS_KEY / SECRET_KEY 복사
#
# 없으면?: 카드에서 네이버 hero 만 표시되고, 쿠팡은 검색 딥링크로 대체됨
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ── Jina Reader (후기·댓글 스크레이프) ─────────────────
# Jina Reader 는 어떤 URL 이든 깨끗한 markdown 으로 변환해줍니다.
#   - 공식 API/Partners 가 돌려주지 않는 별점/후기/댓글을 보강
#   - 키 없이도 분당 20회 무료 (네이버 스마트스토어 추천 페이지에 사용)
#   - 대량 호출이 필요하면 https://jina.ai/reader 에서 무료 키 발급 (월 1M tokens)
#
# 활성화 조건: 아래 둘 중 하나
#   1) JINA_API_KEY 가 설정됨 (자동 활성화 + 인증 호출)
#   2) ENABLE_REVIEW_SCRAPE=1 (익명 호출, rate limit 빠르게 소진될 수 있음)
#
# 네이버 hero 가 우선 사용되며, Essential·Recommended 우선도 품목만 보강됩니다.
# JINA_API_KEY=
# ENABLE_REVIEW_SCRAPE=0

# ── 서버 포트 (기본 3000) ──────────────────────────────
# PORT=3000
